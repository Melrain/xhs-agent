{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "process:default",
    "updater:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://r7ruoxi.com/*" },
        { "url": "http://localhost:8080/*" },
        { "url": "http://127.0.0.1:8080/*" }
      ]
    }
  ]
}
