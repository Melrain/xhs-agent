{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小红书执行器",
  "version": "0.1.2",
  "identifier": "com.zhenyuye.xhs-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "评论用户",
        "width": 1180,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/xhs_qr_login.py"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDOTAzMzMzRDcxQTQ3RTAKUldUZ1J4clhNek9RUEw5dXJBMWRmL0JPekR0R1A4ejA0YTNzcmc3d3VyQkRvL3hDMUNHV0NvOEU=",
      "endpoints": [
        "https://github.com/Melrain/xhs-agent/releases/latest/download/latest.json"
      ]
    }
  }
}
